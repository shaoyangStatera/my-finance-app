# MongoDB Atlas — use the standard (non-SRV) connection string on Windows if SRV fails
MONGODB_URI=mongodb://user:password@host1:27017,host2:27017,host3:27017/?ssl=true&authSource=admin&retryWrites=true&w=majority

# JWT secret for auth tokens (use a long random string in production)
JWT_SECRET=change-me-to-a-long-random-string

# One-time setup secret — used to create the shared account
SETUP_SECRET=change-me-for-initial-setup

# Password for the shared app login (min 16 chars) — also used by npm run seed
SEED_PASSWORD=generate-a-long-random-string-here

# Local dev only — point Expo at your Vercel dev server
EXPO_PUBLIC_API_URL=http://localhost:3000

# Email OTP via Gmail SMTP — required for login and password reset
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your@gmail.com
SMTP_PASS=your-gmail-app-password
FROM_EMAIL=Nestworth <your@gmail.com>
